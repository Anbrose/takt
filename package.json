{
  "name": "takt",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "openapi": "pnpm --filter @takt/contract openapi",
    "dev": "pnpm --filter @takt/api dev",
    "seed": "pnpm --filter @takt/api seed"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
